{
  "name": "@zheref/bankai-core",
  "version": "0.1.0",
  "description": "Bankai library for JavaScript/TypeScript: local-first repositories, feature flags, grouped lists, op tracking, time helpers and a Redux-style UDF store.",
  "license": "MIT",
  "author": "Sergio Daniel Lozano",
  "homepage": "https://github.com/zheref/bankai-library/tree/main/js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zheref/bankai-library.git",
    "directory": "js"
  },
  "bugs": "https://github.com/zheref/bankai-library/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./udf": {
      "types": "./dist/udf/index.d.ts",
      "import": "./dist/udf/index.js",
      "default": "./dist/udf/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "udf": ["./dist/udf/index.d.ts"]
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "PROVENANCE.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
